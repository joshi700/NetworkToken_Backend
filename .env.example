PORT=3006
# Deployed frontend origin (any *.vercel.app origin is also allowed)
FRONTEND_URL=
# Comma-separated host suffixes the proxy may call
ALLOWED_GATEWAY_HOSTS=mastercard.com
# Optional client certificate for certificate authentication (needed for Generate Payment Data).
# PEM content (use \n for newlines) or a file path. Used when the UI doesn't send a certificate.
GATEWAY_CLIENT_CERT=
GATEWAY_CLIENT_KEY=
GATEWAY_CLIENT_KEY_PASSPHRASE=
